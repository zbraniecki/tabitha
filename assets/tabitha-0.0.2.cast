[0.044, "o", "\u001b[1;1H                                                                                             \u001b[2;1H \u001b[38;5;4;49mModal Dialog Example (Centralized ModalManager)                                            \u001b[39;49m \u001b[3;1H \u001b[38;5;4;49m                                                                                           \u001b[39;49m \u001b[4;1H \u001b[38;5;4;49m───────────────────────────────────────────────────────────────────────────────────────────\u001b[39;49m \u001b[5;1H \u001b[38;5;8;49m┌ Enter text ─────────────────────────────────────────────────────────────────────────────┐\u001b[39;49m \u001b[6;1H \u001b[38;5;8;49m│\u001b[38;5;7;49mTest                                                                       "]
[0.000, "o", "              \u001b[38;5;8;49m│\u001b[39;49m \u001b[7;1H \u001b[38;5;8;49m└─────────────────────────────────────────────────────────────────────────────────────────┘\u001b[39;49m \u001b[8;1H ┌ Instructions ───────────────────────────────────────────────────────────────────────────┐ \u001b[9;1H │Keyboard shortcuts:                                                                      │ \u001b[10;1H │                                                                                         │ \u001b[11;1H │1 - Alert modal (single OK button)                                                       │ \u001b[12;1H │2 - Confirmation modal (Delete/Cancel)       \u001b[12;49H                                           │ \u001b[13;1H "]
[0.000, "o", "│3 - Save dialog (Save/Don't\u001b[13;31HSave/Cancel) \u001b[13;46H          \u001b[13;69H                       │ \u001b[14;1H │4 - Rapid modals (demonstrates\u001b[14;34Hreplacement)\u001b[14;69H                       │ \u001b[15;1H │5 - Prompt modal (with input field!)                                                     │ \u001b[16;1H │                                                                                         │ \u001b[17;1H │In modal: Tab to switch focus, Enter to submit, Escape to dismiss                        │ \u001b[18;1H │                                                                                         │ \u001b[19;1H │Note: Modal is drawn by the framework - no manual drawing needed!                        │ \u001b[20;1H │                                                                                         │ \u001b[21;1H │                                                                                         │ \u001b[22;1H └────────────────────────────"]
[0.000, "o", "─────────────────────────────────────────────────────────────┘ \u001b[23;1H \u001b[38;5;3;49m┌ Status ─────────────────────────────────────────────────────────────────────────────────┐\u001b[39;49m \u001b[24;1H \u001b[38;5;3;49m│Hello, Test!                                                                             │\u001b[39;49m \u001b[25;1H \u001b[38;5;3;49m└─────────────────────────────────────────────────────────────────────────────────────────┘\u001b[39;49m \u001b[26;1H                                                                                             \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
