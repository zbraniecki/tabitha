[0.000, "o", "Example!                                                       \u001b[38;5;6;49m│\u001b[6;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[7;1H│\u001b[38;5;15;49mThis example demonstrates focus navigation between widgets.                                \u001b[38;5;6;49m│\u001b[8;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[9;1H│\u001b[38;5;15;49mPress Tab to switch to the 'Data' tab, which contains                                      \u001b[38;5;6;49m│\u001b[10;1H│\u001b[38;5;15;49mtwo tables side by side.                                                                   \u001b[38;5;6;49m│\u001b[11;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[12;1H│\u001b[38;5;15;49mIn the Data tab:                                                                           \u001b[38;5;6;49m│\u001b[13;1H│\u001b[38;5;15;49m• Left/Right arrows: S"]
[0.000, "o", "witch focus between tables                                           \u001b[38;5;6;49m│\u001b[14;1H│\u001b[38;5;15;49m• Up/Down arrows: Navigate rows in the focused table                                       \u001b[38;5;6;49m│\u001b[15;1H│\u001b[38;5;15;49m• The focused table shows selected row in yellow                                           \u001b[38;5;6;49m│\u001b[16;1H│\u001b[38;5;15;49m• The unfocused table shows selected row in gray                                           \u001b[38;5;6;49m│\u001b[17;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[18;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[19;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[20;1H│\u001b[38;5;15;49m                                                                                           \u001b[38;5;6;49m│\u001b[21;1H│\u001b[38;5;15;49m        "]
